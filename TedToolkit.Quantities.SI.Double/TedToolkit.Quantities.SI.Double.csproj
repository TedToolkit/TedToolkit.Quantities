<Project Sdk="Microsoft.NET.Sdk">
  <Import Project="NugetPackage.props" Sdk="TedToolkit.Build.Sdk"/>

  <PropertyGroup>
    <TargetFrameworks>netstandard2.0;net7.0</TargetFrameworks>
    <Description>Precompiled double-precision quantities for the QUDT SI quantity system.</Description>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../TedToolkit.Quantities/TedToolkit.Quantities.csproj"/>
    <ProjectReference Include="../TedToolkit.Quantities.Analyzer/TedToolkit.Quantities.Analyzer.csproj"
                      OutputItemType="Analyzer" ReferenceOutputAssembly="false" PrivateAssets="all"/>
    <Analyzer Include="../TedToolkit.Quantities.Analyzer/bin/$(Configuration)/netstandard2.0/TedToolkit.Quantities.Data.dll"/>
    <Analyzer Include="../TedToolkit.Quantities.Analyzer/bin/$(Configuration)/netstandard2.0/TedToolkit.RoslynHelper.dll"/>
    <Analyzer Include="../TedToolkit.Quantities.Analyzer/bin/$(Configuration)/netstandard2.0/ZString.dll"/>
    <Analyzer Include="../TedToolkit.Quantities.Analyzer/bin/$(Configuration)/netstandard2.0/Numbers.dll"/>
    <Analyzer Include="../TedToolkit.Quantities.Analyzer/bin/$(Configuration)/netstandard2.0/System.Memory.dll"/>
    <Analyzer Include="../TedToolkit.Quantities.Analyzer/bin/$(Configuration)/netstandard2.0/Newtonsoft.Json.dll"/>
  </ItemGroup>
</Project>
